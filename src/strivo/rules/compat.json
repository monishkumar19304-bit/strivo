 "title_rules": {
  "YouTube TV": [
   {
    "kind": "live",
    "set": {
     "ch": "@artist"
    }
   }
  ],
  "YouTube": [
   {
    "kind": "video",
    "set": {
     "ch": "@artist"
    }
   }
  ],
  "Hulu": [
   {
    "field": "title",
    "match": "(.+?)\\s*\\|\\s*S(\\d+)\\s*E(\\d+)\\s*-\\s*(.*)",
    "kind": "episode",
    "set": {
     "series": 1,
     "season": 2,
     "ep": 3,
     "ept": 4
    }
   }
  ],
  "Prime Video": [
   {
    "field": "artist",
    "match": "(?:Season\\s*|S)(\\d+),?\\s*(?:Ep\\.?\\s*|E)(\\d+)\\s*(.*)",
    "kind": "episode",
    "set": {
     "series": "@title",
     "season": 1,
     "ep": 2,
     "ept": 3
    }
   }
  ],
  "HBO Max": [
   {
    "field": "artist",
    "match": "(.+)",
    "kind": "episode",
    "set": {
     "series": "@artist",
     "ept": "@title"
    }
   }
  ]
 },
 "launch": {
  "trailer": {
   "appletv": {
    "app": "com.google.ios.youtube",
    "link": "youtube://watch/{id}"
   },
   "android": {
    "app": "com.google.android.youtube.tv",
    "link": "https://www.youtube.com/watch?v={id}"
   },
   "firetv": {
    "app": "com.amazon.firetv.youtube",
    "link": "https://www.youtube.com/watch?v={id}"
   },
   "roku": {
    "app": "837",
    "link": "{id}"
   }
  }
 },
